# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Override the application title/icon if desired.
APP_TITLE=AI-Powered Stock Market Dashboard

# ---------------------------------------------------------------------------
# News data
# ---------------------------------------------------------------------------
# Provider used for news ingestion. "yfinance" (default) needs no credentials.
# "newsapi" requires a NEWSAPI_KEY and fetches a broader set of headlines.
NEWS_PROVIDER=yfinance

# Maximum number of articles fetched per ticker.
NEWS_LIMIT=20

# Recency window (hours) for the "recent" aggregation and article filtering.
NEWS_RECENCY_HOURS=72

# Headline de-duplication similarity threshold (difflib ratio, 0.0-1.0).
# Articles whose normalised titles exceed this are treated as duplicates.
NEWS_DEDUP_SIMILARITY=0.9

# ---------------------------------------------------------------------------
# Sentiment model
# ---------------------------------------------------------------------------
# HuggingFace model id used for financial sentiment. The default is FinBERT
# (yiyanghkust/finbert-tone), a finance-tuned 3-class classifier. If it
# cannot be loaded the pipeline falls back to a finance lexicon classifier.
FINBERT_MODEL=yiyanghkust/finbert-tone

# Minimum model confidence (winning-class probability) below which an article
# is still surfaced but flagged as low-confidence by the UI.
SENTIMENT_CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# Optional: external news API credentials
# ---------------------------------------------------------------------------
# Required ONLY if NEWS_PROVIDER=newsapi. Streamlit users may place these in
# .streamlit/secrets.toml (git-ignored) instead of the environment.
NEWSAPI_KEY=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
